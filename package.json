{
  "name": "cua-mcp",
  "version": "1.0.0",
  "description": "Drive a browser and your Mac desktop over MCP — navigate, screenshot, click, type, download, and full computer control for Claude Code and other MCP clients.",
  "type": "module",
  "bin": {
    "cua-mcp": "dist/cli.js"
  },
  "files": [
    "dist/",
    "native/",
    "cua_input.c",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/build-native.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsc --watch"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "playwright",
    "browser-automation",
    "computer-use",
    "desktop-automation",
    "agent"
  ],
  "author": "Rohit Upadhya",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohit-upadhya/cua-mcp.git"
  },
  "homepage": "https://github.com/rohit-upadhya/cua-mcp#readme",
  "bugs": {
    "url": "https://github.com/rohit-upadhya/cua-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.48.0",
    "zod": "^3.23.8"
  },
  "optionalDependencies": {
    "node-mac-permissions": "^2.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  }
}
